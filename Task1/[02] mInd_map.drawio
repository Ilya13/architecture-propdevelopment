        <mxCell id="GToTN5T6n2CrcWgCc6yh-1791" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;b&gt;Риск&lt;/b&gt;: Утечка&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18));&quot;&gt;&lt;b&gt;Обоснование&lt;/b&gt;:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Кража финансовой информации может привести к финансовым потерям компании и клиентов&lt;/span&gt;&lt;/div&gt;&lt;b&gt;Оценка&lt;/b&gt;: Критический&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;labelBackgroundColor=none;strokeColor=none;strokeWidth=3;fillColor=#81CCE5;fontFamily=Helvetica;fontSize=14;fontColor=#FFFFFF;align=center;spacing=5;arcSize=7;perimeterSpacing=2;" vertex="1" parent="1">
          <mxGeometry x="585" y="770" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="GToTN5T6n2CrcWgCc6yh-1792" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;b&gt;Риск&lt;/b&gt;: Утечка&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18));&quot;&gt;&lt;b&gt;Обоснование&lt;/b&gt;:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Несанкционированный доступ к логам может скрыть следы инцидентов безопасности&lt;/span&gt;&lt;/div&gt;&lt;b&gt;Оценка&lt;/b&gt;: Значительный&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;labelBackgroundColor=none;strokeColor=none;strokeWidth=3;fillColor=#81CCE5;fontFamily=Helvetica;fontSize=14;fontColor=#FFFFFF;align=center;spacing=5;arcSize=7;perimeterSpacing=2;" vertex="1" parent="1">
          <mxGeometry x="265" y="770" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="GToTN5T6n2CrcWgCc6yh-1793" value="&lt;div style=&quot;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18));&quot;&gt;Риск&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18));&quot;&gt;: Искажение&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18));&quot;&gt;&lt;b&gt;Обоснование&lt;/b&gt;:&amp;nbsp;Несанкционированное изменение цен или характеристик может ввести в заблуждение клиентов и нанести ущерб репутации&lt;/span&gt;&lt;/div&gt;&lt;b&gt;Оценка&lt;/b&gt;: Значительный&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;labelBackgroundColor=none;strokeColor=none;strokeWidth=3;fillColor=#81CCE5;fontFamily=Helvetica;fontSize=14;fontColor=#FFFFFF;align=left;spacing=5;arcSize=7;perimeterSpacing=2;" vertex="1" parent="1">
          <mxGeometry x="-375" y="770" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="GToTN5T6n2CrcWgCc6yh-1794" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;b&gt;Риск&lt;/b&gt;: Утечка&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18));&quot;&gt;&lt;b&gt;Обоснование&lt;/b&gt;:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Приведёт к штрафам и потере доверия клиентов&lt;/span&gt;&lt;/div&gt;&lt;b&gt;Оценка&lt;/b&gt;: Критический&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;labelBackgroundColor=none;strokeColor=none;strokeWidth=3;fillColor=#81CCE5;fontFamily=Helvetica;fontSize=14;fontColor=#FFFFFF;align=center;spacing=5;arcSize=7;perimeterSpacing=2;" vertex="1" parent="1">
